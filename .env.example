# Copie para `.env` na raiz do projeto. Modelo, provedor e base URL vêm daqui.
# NÃO há valores default no código: sem estas variáveis o caminho com LLM fica
# desativado e o fluxo segue determinístico (sem chamada de modelo).
#
# Exemplos:
#   OpenAI        : LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini
#   OpenRouter    : LLM_PROVIDER=openrouter LLM_MODEL=anthropic/claude-sonnet-4-6
#                   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LiteLLM proxy : LLM_PROVIDER=litellm    LLM_MODEL=<modelo>  LLM_BASE_URL=http://localhost:4000
#   Outro router  : LLM_PROVIDER=compat     LLM_MODEL=<modelo>  LLM_BASE_URL=https://api.exemplo/v1

LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
